{"title":"EDAI2 LLM","panels":[{"title":"Input tokens","targets":[{"expr":"sum(edai2_llm_input_tokens_total)"}]},{"title":"Output tokens","targets":[{"expr":"sum(edai2_llm_output_tokens_total)"}]},{"title":"Total tokens","targets":[{"expr":"sum(edai2_llm_total_tokens_total)"}]},{"title":"Generation RTT","targets":[{"expr":"histogram_quantile(0.95, sum by (le) (rate(edai2_llm_generation_seconds_bucket[5m])))"}]},{"title":"TTFT","targets":[{"expr":"histogram_quantile(0.95, sum by (le) (rate(edai2_llm_ttft_seconds_bucket[5m])))"}]},{"title":"Safety/PII","targets":[{"expr":"sum by (safety_action) (edai2_safety_actions_total)"}]}]}
