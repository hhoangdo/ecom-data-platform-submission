+package main
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/agent-substrate/substrate/cmd/ateapi/internal/store/ateredis"
+	"github.com/agent-substrate/substrate/pkg/proto/ateapipb"
+	"github.com/alicebob/miniredis/v2"
+	"github.com/redis/go-redis/v9"
+)
+
+func TestReadRedisPassword(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "password")
+	if err := os.WriteFile(path, []byte("secret\r\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	password, err := readRedisPassword(path)
+	if err != nil || password != "secret" {
+		t.Fatalf("readRedisPassword() = %q, %v; want secret", password, err)
+	}
+	if err := os.WriteFile(path, []byte(" \r\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := readRedisPassword(path); err == nil {
+		t.Fatal("readRedisPassword() accepted an empty password file")
+	}
+	if _, err := readRedisPassword(filepath.Join(t.TempDir(), "missing")); err == nil {
+		t.Fatal("readRedisPassword() accepted a missing password file")
+	}
+}
+
+func TestRedisCredentialsProviderRejectsMissingCredentialsFile(t *testing.T) {
+	t.Setenv("GOOGLE_APPLICATION_CREDENTIALS", filepath.Join(t.TempDir(), "missing-credentials.json"))
+	original := *redisUseIAMAuth
+	*redisUseIAMAuth = "true"
+	t.Cleanup(func() { *redisUseIAMAuth = original })
+
+	if _, err := redisCredentialsProvider(context.Background()); err == nil {
+		t.Fatal("redisCredentialsProvider() accepted a missing ADC credentials file")
+	}
+}
+
+func TestStandaloneRedisPasswordAuthAndPersistenceTransaction(t *testing.T) {
+	server, err := miniredis.Run()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer server.Close()
+	server.RequireAuth("secret")
+
+	ctx := context.Background()
+	noPasswordClient := redis.NewClient(&redis.Options{Addr: server.Addr()})
+	if err := noPasswordClient.Ping(ctx).Err(); err == nil {
+		t.Fatal("Redis accepted a client without a password")
+	}
+	_ = noPasswordClient.Close()
+
+	wrongPasswordClient := redis.NewClient(&redis.Options{Addr: server.Addr(), Password: "wrong"})
+	if err := wrongPasswordClient.Ping(ctx).Err(); err == nil {
+		t.Fatal("Redis accepted a wrong password")
+	}
+	_ = wrongPasswordClient.Close()
+
+	client := redis.NewClient(&redis.Options{Addr: server.Addr(), Password: "secret"})
+	defer client.Close()
+	wrapped := newStandaloneRedisPersistenceClient(client)
+	if err := wrapped.Ping(ctx).Err(); err != nil {
+		t.Fatalf("Redis rejected the correct password: %v", err)
+	}
+
+	persistence := ateredis.NewPersistence(wrapped)
+	worker := &ateapipb.Worker{
+		WorkerNamespace: "kagent", WorkerPool: "pool", WorkerPod: "worker-1", Ip: "127.0.0.1",
+	}
+	if err := persistence.CreateWorker(ctx, worker); err != nil {
+		t.Fatalf("CreateWorker() error = %v", err)
+	}
+	if err := persistence.UpdateWorker(ctx, worker, 1); err != nil {
+		t.Fatalf("UpdateWorker() error = %v", err)
+	}
+	stored, err := persistence.GetWorker(ctx, "kagent", "pool", "worker-1")
+	if err != nil {
+		t.Fatalf("GetWorker() error = %v", err)
+	}
+	if stored.GetVersion() != 2 {
+		t.Fatalf("stored version = %d, want 2", stored.GetVersion())
+	}
+
+	calls := 0
+	err = wrapped.ForEachMaster(ctx, func(_ context.Context, master *redis.Client) error {
+		calls++
+		if master != client {
+			t.Fatal("standalone master iterator returned a different client")
+		}
+		return nil
+	})
+	if err != nil || calls != 1 {
+		t.Fatalf("standalone ForEachMaster() calls=%d error=%v; want one call", calls, err)
+	}
+}
+
+func TestConnectStandaloneRedisWithoutPassword(t *testing.T) {
+	server, err := miniredis.Run()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer server.Close()
+
+	originalMode := *redisMode
+	originalAddress := *redisClusterAddress
+	originalPasswordFile := *redisPasswordFile
+	originalIAMAuth := *redisUseIAMAuth
+	originalNoTLS := *redisNoTLS
+	*redisMode = "standalone"
+	*redisClusterAddress = server.Addr()
+	*redisPasswordFile = ""
+	*redisUseIAMAuth = "false"
+	*redisNoTLS = true
+	t.Cleanup(func() {
+		*redisMode = originalMode
+		*redisClusterAddress = originalAddress
+		*redisPasswordFile = originalPasswordFile
+		*redisUseIAMAuth = originalIAMAuth
+		*redisNoTLS = originalNoTLS
+	})
+
+	client, err := connectRedis(context.Background())
+	if err != nil {
+		t.Fatalf("connectRedis() without a password failed: %v", err)
+	}
+	defer client.close()
+	if err := client.Ping(context.Background()).Err(); err != nil {
+		t.Fatalf("standalone Redis Ping() without a password failed: %v", err)
+	}
+}
+
+func TestRedisPersistenceClientDelegatesClusterMasterIteration(t *testing.T) {
+	client := redis.NewClient(&redis.Options{Addr: "127.0.0.1:1"})
+	defer client.Close()
+	wantedErr := errors.New("cluster iterator invoked")
+	called := false
+	wrapped := &redisPersistenceClient{
+		Cmdable: client,
+		watch: client.Watch,
+		forEachMaster: func(context.Context, func(context.Context, *redis.Client) error) error {
+			called = true
+			return wantedErr
+		},
+	}
+	err := wrapped.ForEachMaster(context.Background(), func(context.Context, *redis.Client) error { return nil })
+	if !called || !errors.Is(err, wantedErr) {
+		t.Fatalf("ForEachMaster() called=%t error=%v; want cluster delegation", called, err)
+	}
+}
