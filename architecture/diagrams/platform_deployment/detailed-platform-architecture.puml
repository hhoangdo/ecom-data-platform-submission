@startuml
title Vina Bim Shop Target Platform Architecture - Detailed GKE Deployment
caption Proposed Section 03/04.2 target - not proof of a live deployment.

skinparam componentStyle rectangle
skinparam shadowing false
skinparam wrapWidth 230
skinparam defaultFontSize 12
skinparam ArrowFontSize 9
skinparam nodesep 40
skinparam ranksep 65
skinparam linetype ortho
left to right direction

actor "Developer /\nPlatform Operator" as Developer
actor "Customer / Reviewer" as Customer
actor "Executive Users" as Executive
actor "BI / Livestreaming Users" as BI
component "GitHub\napplication source and eight\neffective-dated policy documents" as GitHub

rectangle "Google Cloud Project" as GCPProject {
  rectangle "Managed GCP services" as ManagedGcp {
    component "Artifact Registry\nimmutable commit-SHA images" as ArtifactRegistry
    component "GCS\nKMS-protected Section 03 bundles, model cache,\nbackups, evidence, and Langfuse raw events" as GCS
    component "GCP KMS\nencryption and Vault auto-unseal keys" as KMS
    component "IAM / Workload Identity\nleast-privilege workload access" as WorkloadIdentity
    component "$240 budget guardrail\n50/75/90/100% alerts" as Budget
  }

  node "Zonal Standard GKE\nus-central1-a" as GKE {
    node "Regular platform pool\ne2-highmem-4 | regular VM | manually resizable to zero" as RegularPool {
      rectangle "edai2" as RegularEdai2 {
        component "Cluster Controllers Workload Group\ncert-manager | KEDA | External Secrets" as ClusterControllers
        component "Temporary HTTPS Ingress\ningress-nginx public edge | evidence only" as Ingress
        component "Single Redpanda Event Backbone\nStatefulSet | Kafka API\nsource, feature-update, and redacted DLQ topics" as Redpanda
        component "Source Contracts and Lakehouse Serving Workload Group\nSource-topic Schema Registry | Kafka Connect\nMinIO Bronze + Iceberg Silver/Gold | Hive Metastore\nTrino canonical Gold | Pinot provisional realtime" as LakehouseServingGroup
        component "PostgreSQL / pgvector\nactive RAG index | Section 03 health and feature-label views\noffline rows, outbox, dedup, and checkpoints" as PostgresVector
        component "Feast Retrieval / Feature Service\nactive index and feature-view boundary" as Feast
        component "Valkey\nFeast online store and shared runtime state" as Valkey
        component "Airflow and Governance Workload Group\nAirflow webserver/scheduler | DataHub | OpenSearch" as PlatformControl
        component "Jenkins Controller\nCI, release, smoke, and rollback; zero executors" as Jenkins
        component "Agent Registry\nthree logical agent identities and versions" as AgentRegistry
        component "Observability Workload Group\nGrafana Alloy -> Prometheus, Loki, Tempo -> Grafana\nLangfuse v3 -> ClickHouse; raw events -> GCS" as Observability
      }

      rectangle "kagent" as RegularKagent {
        component "kagent Control Workload Group\nkagent controller | Agent Substrate control plane" as KagentControl
        component "kagent Chat UI\noptional browser bootstrap only" as KagentUI
        component "agentgateway\ninternal A2A, MCP, and model policy proxy" as AgentGateway
      }

      rectangle "vault" as RegularVault {
        component "Vault\nsingle-replica Raft | Kubernetes auth\nGCP KMS auto-unseal" as Vault
      }
    }

    node "Workload pool\ne2-standard-8 | Spot | zero-to-two nodes maximum\nmanually resizable to zero" as SpotPool {
      rectangle "edai2" as SpotEdai2 {
        rectangle "Data, index, and streaming jobs" as SpotDataJobs {
          component "Python Marketplace Generator\nJob | deterministic snapshots and events" as Generator
          component "Batch and Stream Processing Workload Group\nSpark Batch / DP3 | Flink Streaming\nGreat Expectations | dbt-DuckDB parity" as DataProcessing
          component "Section 03 Validation / DP3 Job\ndrift, daily health/PSI, alerts, leakage-safe join\nexact id,label and immutable manifest" as Section03
          component "Strict Section 03 Loader\nJob | fail-closed GCS verification and activation" as Section03Loader
          component "RAG Candidate-index Job\nAirflow-launched | 400-token chunks, 80 overlap\nBGE-small-en-v1.5 | 384 dimensions" as RagIndex
          component "Feature Writer Workload Group\nindependent offline and online consumers\nidempotent checkpoints and deterministic DLQ" as FeatureWriters
        }

        rectangle "Agent APIs, tools, build, and inference" as SpotApplication {
          component "Coordinator FastAPI Facade\n/v1/chat | /healthz | /readyz | /metrics" as CoordinatorApi
          component "Retrieval MCP Server\nsearch_ecommerce_knowledge" as RetrievalMcp
          component "Retrieval FastAPI API\n/v1/retrieval/search" as RetrievalApi
          component "Drift MCP Server\ndetect_customer_order_drift" as DriftMcp
          component "Drift FastAPI API\ninternal /v1/drift/detect" as DriftApi
          component "Ephemeral Rootless BuildKit\nJenkins agent | Trivy | maximum one pod" as BuildKit
          component "llm-d CPU Router\ninternal | 4096-token context | concurrency one" as Llmd
          component "Qwen/Qwen2.5-1.5B-Instruct\nprimary CPU endpoint" as QwenPrimary
          component "Qwen/Qwen2.5-0.5B-Instruct\ncomparison CPU endpoint | evidence only" as QwenComparison
        }
      }

      rectangle "kagent\n3 logical agents / 5 SandboxAgent resources" as SpotKagent {
        component "support-retrieval Agent\nkagent SandboxAgent workload" as SupportAgent
        component "drift-analyst Agent\nkagent SandboxAgent workload" as DriftAgent
        component "Coordinator Agent\nlogical kagent routing identity" as CoordinatorAgent
        component "Coordinator Runtime Workload Group\nSandboxAgent: coordinator-v1-primary\nSandboxAgent: coordinator-v2-primary\nSandboxAgent: coordinator-v1-comparison (evidence only)" as CoordinatorRuntimes
        component "Agent Substrate WorkerPool\nelastic agent runtime capacity" as AgentWorkerPool
      }
    }
  }
}

